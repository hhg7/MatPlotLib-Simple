      1978  
      1979 +## venn_proportional_area                                    
      1980 +                                                             
      1981 +Draw an area-proportional Venn diagram, where the size of eac
           +h region is scaled                                           
      1982 +to the number of elements it contains.  This plot type wraps 
           +the                                                          
      1983 +[`matplotlib_venn`](https://pypi.org/project/matplotlib-venn/
           +) library, so that                                           
      1984 +library must be installed in addition to `matplotlib`:       
      1985 +                                                             
      1986 +    python3 -m pip install matplotlib-venn                   
      1987 +                                                             
      1988 +`data` is a hash of array references; each key is a **set** a
           +nd its array is the                                          
      1989 +set's members (duplicates within a set are collapsed, exactly
           + like a                                                      
      1990 +mathematical set).  Because `matplotlib_venn` only draws prop
           +ortional-area                                                
      1991 +diagrams for two or three sets, `data` must contain either **
           +2 or 3** keys.  By                                           
      1992 +default the sets are labelled and ordered alphabetically by k
           +ey; use `key.order`                                          
      1993 +to override that.                                            
      1994 +                                                             
      1995 +### options                                                  
      1996 +                                                             
      1997 +| Option | Description | Example |                           
      1998 +| -------- | ------- | ------- |                             
      1999 +|`alpha`| opacity of the set regions, `0`–`1` (default `0.4`)
           + | `alpha => 0.5`|                                           
      2000 +|`key.order`| array ref giving the order (and hence label pos
           +itions) of the sets | `'key.order' => ['Right','Left']`|     
      2001 +|`set_colors`| array ref of colors, one per set | `set_colors
           + => [qw(skyblue lightgreen salmon)]`|                        
      2002 +|`title`| the subplot title | `title => 'Gospels vs. Synoptic
           +s'`|                                                         
      2003 +                                                             
      2004 +### single, simple plot                                      
      2005 +                                                             
      2006 +`venn_proportional_area` is a single-plot wrapper around `plt
           +`, so it can be                                              
      2007 +called directly:                                             
      2008 +                                                             
      2009 +    venn_proportional_area(                                  
      2010 +            'output.file' => 'output.images/single.venn.png',        
      2011 +            title         => 'Gospels vs. Synoptics',                
      2012 +            data          => {                                       
      2013 +                    Gospels  => [qw(Matthew Mark Luke John)],                
      2014 +                    Synoptic => [qw(Matthew Mark Luke)],                     
      2015 +            },                                                       
      2016 +    );                                                       
      2017 +                                                             
      2018 +which makes the image:                                       
      2019 +                                                             
      2020 +<img alt="single venn" src="output.images/single.venn.png" />
      2021 +                                                             
      2022 +### multiple plots                                           
      2023 +                                                             
      2024 +Like every other plot type, it can also be one panel among se
           +veral via `plt`                                              
      2025 +and the `plots` array; here a two-set diagram sits beside a c
           +olored three-set                                             
      2026 +diagram:                                                     
      2027 +                                                             
      2028 +    plt(                                                     
      2029 +            'output.file' => 'output.images/venn.png',               
      2030 +            ncols         => 2,                                      
      2031 +            suptitle      => 'Proportional-area Venn diagrams',      
      2032 +            plots => [                                               
      2033 +                    {                                                        
      2034 +                            'plot.type' => 'venn_proportional_area',                 
      2035 +                            title       => 'Two sets',                               
      2036 +                            data        => {                                         
      2037 +                                    Perl   => [qw(regex hashes CPAN sigils)],                
      2038 +                                    Python => [qw(regex hashes pip indentation)],            
      2039 +                            },                                                       
      2040 +                    },                                                       
      2041 +                    {                                                        
      2042 +                            'plot.type'  => 'venn_proportional_area',                
      2043 +                            title        => 'Three sets with colors',                
      2044 +                            set_colors   => [qw(skyblue lightgreen salmon)],         
      2045 +                            alpha        => 0.5,                                     
      2046 +                            data         => {                                        
      2047 +                                    Mammals => [qw(bat whale dog cat human platypus)],       
      2048 +                                    Aquatic => [qw(whale shark octopus platypus)],           
      2049 +                                    Legged  => [qw(dog cat human bat platypus shark)],       
      2050 +                            },                                                       
      2051 +                    },                                                       
      2052 +            ],                                                       
      2053 +    );                                                       
      2054 +                                                             
      2055 +which makes the following figure:                            
      2056 +                                                             
      2057 +<img alt="venn diagrams" src="output.images/venn.png" />     
      2058 +                                                             
      2059  ## violin
      2060  
      2061  plot a hash of array refs as violins

